{
  "request": {
    "method": "POST",
    "urlPath": "/example.v1.GreeterService/Greet",
    "headers": {
      "Connect-Protocol-Version": { "equalTo": "1" }
    },
    "customMatcher": {
      "name": "connect-rpc",
      "parameters": {
        "jsonBody": { "name": "Josh" }
      }
    }
  },
  "response": {
    "transformers": ["connect-rpc-response"],
    "transformerParameters": {
      "jsonBody": { "greeting": "Hello, Josh!" }
    }
  }
}
